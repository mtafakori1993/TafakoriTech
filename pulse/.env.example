# ═══════════════════════════════════════════════════════════════
# Pulse — environment variables
# Lines marked REQUIRED will cause startup to fail if left empty.
# Lines marked optional can be omitted; the default shown is used.
# ═══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
HOST=0.0.0.0                        # optional  default: 0.0.0.0
PORT=9505                           # optional  default: 9505
ENV=development                     # optional  development | production

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgres://pulse:secret@localhost:5432/pulse?sslmode=disable   # REQUIRED

# ── Auth (shared with Sentinel) ─────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string   # REQUIRED

# ── Worker pool ─────────────────────────────────────────────────
WORKER_COUNT=4                      # optional  default: 4
QUEUE_BUFFER=1000                   # optional  default: 1000

# ── Email / SMTP ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com            # optional
SMTP_PORT=587                       # optional  default: 587
SMTP_USER=noreply@tafakori.tech     # optional
SMTP_PASS=                          # optional
SMTP_FROM=Pulse <noreply@tafakori.tech>  # optional  default: no-reply@tafakori.tech

# ── SMS provider ────────────────────────────────────────────────
SMS_PROVIDER=smsir                  # optional  smsir | ghasedak  (default: smsir)

# SMS.ir (used when SMS_PROVIDER=smsir)
SMSIR_API_KEY=                      # optional  required only when SMS channel is used
SMSIR_LINE_NUMBER=30007732XXXXXX    # optional  dedicated line number for bulk send

# Ghasedak (used when SMS_PROVIDER=ghasedak)
GHASEDAK_API_KEY=                   # optional  required only when SMS channel is used
GHASEDAK_LINE_NUMBER=210002100      # optional  dedicated line number
