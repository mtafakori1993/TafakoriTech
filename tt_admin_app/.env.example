# Copy this file to .env and fill in the values.
# Injected into BuildConfig by app/build.gradle.kts; used as defaults on the
# in-app setup screens. Keep keys in sync with ../infra/.env.

# Kong proxy URL (host LAN IP + Kong proxy port 8080).
GATEWAY_BASE_URL=http://127.0.0.1:8080

# Service API keys (X-API-Key) — must match ../infra/.env.
MARSHAL_API_KEY=change-me-marshal
HERALD_API_KEY=1fb120706eba33543b7e5a425d41f840
COMMANDER_API_KEY=change-me-commander
HARBOR_API_KEY=change-me-harbor
