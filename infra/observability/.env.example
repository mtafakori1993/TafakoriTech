# ── Observability stack environment ──────────────────────────────────────────
# Copy to .env and fill in values before running setup.sh

# Elasticsearch
ES_HOST=127.0.0.1
ES_PORT=9200
ES_USER=elastic
# ELASTIC_PASSWORD is read from the Docker secret; only needed for setup.sh locally
ELASTIC_PASSWORD=change-me

# Kibana
KB_HOST=127.0.0.1
KB_PORT=9908
