# Copy this file to .env and fill in the values.

# swarm image references (must be pre-built and pushed before deploying)
MARSHAL_IMAGE=TafakoriTech/marshal:latest
HERALD_IMAGE=TafakoriTech/herald:latest

# postgres
POSTGRES_USER=commander
POSTGRES_PASSWORD=KyUzb5nOCHvE9lB88FyzKMWGjVzu9u9NR
POSTGRES_DB=commander

# marshal (formerly project-manager)
DATABASE_URL=postgresql://commander:KyUzb5nOCHvE9lB88FyzKMWGjVzu9u9NR@postgres:5432/marshal
PM_API_KEY=change-me-marshal

# herald (headless CMS) — uses a separate database on the same postgres instance
HERALD_DATABASE_URL=postgresql://commander:KyUzb5nOCHvE9lB88FyzKMWGjVzu9u9NR@postgres:5432/herald
HERALD_API_KEY=1fb120706eba33543b7e5a425d41f840

# harbor (low-code platform) — uses a separate database on the same postgres instance
HARBOR_DB_DSN=postgres://commander:your-postgres-password@postgres:5432/harbor?sslmode=disable
